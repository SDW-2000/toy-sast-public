# Application
APP_ENV=local
WEB_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000
# Keep loopback defaults unless access from another LAN device is required.
WEB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1

# PostgreSQL: copy this file to .env and replace blank secrets.
POSTGRES_DB=toy_sast
POSTGRES_USER=toy_sast
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://toy_sast:CHANGE_ME@postgres:5432/toy_sast

# Authentication
SESSION_SECRET=
SESSION_ABSOLUTE_TTL_SECONDS=3600
INVITATION_TTL_SECONDS=86400
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@toy-sast.local

# Source and analyzer
SOURCE_STORAGE_ROOT=/data/sources
WORKSPACE_ROOT=/work
MAX_UPLOAD_BYTES=52428800
MAX_REQUEST_BODY_BYTES=53477376
ANALYSIS_TIMEOUT_SECONDS=300
ANALYSIS_IDLE_TIMEOUT_SECONDS=180
ANALYSIS_MAX_TIMEOUT_SECONDS=1800
ANALYSIS_HEARTBEAT_SECONDS=30
ANALYZER_MAX_OUTPUT_BYTES=16777216
ANALYZER_MAX_FINDINGS=10000
ANALYZER_RULES_ROOT=/analyzer/rules
ANALYZER_MEMORY_LIMIT=4g
SCAN_JOB_LEASE_SECONDS=600
SCAN_MAX_ATTEMPTS=3
